  {
    "datos_resumen": "Riego del Camino · † marzo de 1938",
    "lugar_descanso": null,
    "hijos": [],
    "estado": "documented",
    "conyuges": [],
    "hechos": [
      {
        "tipo": "documentado",
        "texto": "Hijo de Francisco de la Dehesa Baladrón y Josefa Martín Calles."
      },
      {
        "tipo": "documentado",
        "texto": "Resultó herido en una reyerta familiar publicada el 8 de enero de 1934."
      },
      {
        "tipo": "documentado",
        "texto": "El 27 de septiembre de 1935 se anunció su procesamiento y juicio por estupro."
      },
      {
        "tipo": "documentado",
        "texto": "El 11 de noviembre de 1935 se publicó la condena, que incluyó multa de 2.500 pesetas, costas e indemnización civil."
      },
      {
        "tipo": "documentado",
        "texto": "El 18 de agosto de 1936 figura entre los soldados y clases ascendidos por acciones distinguidas."
      },
      {
        "tipo": "documentado",
        "texto": "El 4 de marzo de 1938 se informó del traslado a Riego del Camino de sus restos, como suboficial del Regimiento Toledo."
      },
      {
        "tipo": "documentado",
        "texto": "En 1942 se reconoció una pensión a sus padres, Francisco de la Dehesa Baladrón y Josefa Martín Calles, con efectos de 13 de marzo de 1938."
      },
      {
        "tipo": "hipotesis",
        "texto": "Posible hermano de Manuel y Cayetano de la Dehesa Martín; parentesco pendiente de prueba directa."
      }
